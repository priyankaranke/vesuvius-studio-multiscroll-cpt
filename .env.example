# Copy to .env (git-ignored) and fill in only what you need. Every setting is optional.
# Scripts read .env from the repository root; variables already set in the environment take precedence.

# Hugging Face read token: needed only while the data and model repositories are private. Once they are public,
# leave it empty (downloads work anonymously). `hf auth login` works too, instead of this line.
HF_TOKEN=

# Weights & Biases logging: off unless STUDIO_WANDB=1. Credentials come from `wandb login` (or WANDB_API_KEY).
STUDIO_WANDB=0
WANDB_ENTITY=
WANDB_PROJECT=studio-814-841-9b

# Stop training after N optimizer updates with a resumable checkpoint (0 = the full 82,500-update run).
STUDIO_MAX_UPDATES=0

# Only for re-rendering the CT tiles from the public scans (not needed to train):
# docker command (e.g. "sudo -n docker" where docker needs root) and the renderer runtime folder
STUDIO_DOCKER=docker
STUDIO_RENDER_RUNTIME=
